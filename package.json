{
  "name": "frigonais-v2",
  "version": "2.2.1",
  "private": true,
  "description": "Frigonais B2B presentation website",
  "scripts": {
    "build:config": "node scripts/build-config.mjs",
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --minify",
    "build:copy": "node scripts/apply-copy-fixes.mjs",
    "build:deploy": "node scripts/prepare-deploy.mjs",
    "build:seo": "node scripts/seo-build.mjs",
    "build": "npm run build:config && npm run build:css && npm run build:copy && npm run build:deploy && npm run build:seo",
    "check": "node scripts/check.mjs",
    "check:seo": "node scripts/check-seo.mjs"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}