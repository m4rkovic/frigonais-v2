{
  "name": "frigonais-v2",
  "version": "2.3.6",
  "private": true,
  "description": "Frigonais B2B presentation website",
  "scripts": {
    "build:config": "node scripts/build-config.mjs",
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --minify",
    "build:copy": "node scripts/apply-copy-fixes.mjs",
    "build:original": "node scripts/apply-original-content.mjs",
    "build:original-final": "node scripts/apply-original-final.mjs",
    "build:seo-source": "node scripts/patch-seo-original.mjs",
    "build:range": "node scripts/apply-product-range-priority.mjs",
    "build:lang-fix": "node scripts/apply-iqf-language-fix.mjs",
    "build:legacy": "node scripts/apply-legacy-source-truth.mjs",
    "build:visual": "node scripts/apply-landing-visual-tweaks.mjs",
    "build:sticky-cta": "node scripts/apply-sticky-cta.mjs",
    "build:single-url-lang": "node scripts/apply-single-url-language.mjs",
    "build:deploy": "node scripts/prepare-deploy.mjs",
    "build:seo": "node scripts/seo-build.mjs",
    "build": "npm run build:config && npm run build:css && npm run build:copy && npm run build:original && npm run build:original-final && npm run build:seo-source && npm run build:range && npm run build:lang-fix && npm run build:legacy && npm run build:visual && npm run build:sticky-cta && npm run build:single-url-lang && npm run build:deploy && npm run build:seo",
    "check": "node scripts/check.mjs",
    "check:seo": "node scripts/check-seo.mjs"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
